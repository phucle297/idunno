#!/usr/bin/env bash
set -euo pipefail

readonly GODOT_VERSION="4.7.2-stable"
readonly GODOT_VERSION_OUTPUT="4.7.2.stable"
readonly GODOT_ARCHIVE="Godot_v${GODOT_VERSION}_linux.x86_64.zip"
readonly GODOT_BINARY="Godot_v${GODOT_VERSION}_linux.x86_64"
readonly GODOT_URL="https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}/${GODOT_ARCHIVE}"
readonly GODOT_SHA512="9aa00f7a605200940bce3027a567b782f49bd8e940dd06ae9e987bd65aee1b1467edd56ed84fcdcbdd44354bf613bdbb4e5d2913e925850368e150c59ed54c65"

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
tool_dir="$repo_root/.tools/godot"
godot_path="$tool_dir/$GODOT_BINARY"

timestamp() {
  date -u +%Y-%m-%dT%H:%M:%SZ
}

step() {
  printf '\n[%s] %s\n' "$(timestamp)" "$1"
}

install_prerequisites() {
  local packages=()
  command -v curl >/dev/null 2>&1 || packages+=(curl)
  command -v unzip >/dev/null 2>&1 || packages+=(unzip)
  command -v Xvfb >/dev/null 2>&1 || packages+=(xvfb)
  command -v xauth >/dev/null 2>&1 || packages+=(xauth)

  if ((${#packages[@]} == 0)); then
    echo "System prerequisites already available."
    return
  fi

  echo "Installing missing system prerequisites: ${packages[*]}"
  sudo -n apt-get update
  sudo -n apt-get install -y --no-install-recommends "${packages[@]}"
}

install_godot() {
  mkdir -p "$tool_dir"

  if [[ -x "$godot_path" ]] && "$godot_path" --headless --version | grep -Fq "$GODOT_VERSION_OUTPUT"; then
    echo "Godot $GODOT_VERSION is already installed."
  else
    local archive_path="$tool_dir/$GODOT_ARCHIVE"
    local temporary_archive="$archive_path.tmp"
    rm -f "$temporary_archive"

    echo "Downloading Godot $GODOT_VERSION."
    curl --fail --location --retry 3 --retry-delay 2 --output "$temporary_archive" "$GODOT_URL"
    printf '%s  %s\n' "$GODOT_SHA512" "$temporary_archive" | sha512sum --check --status
    mv "$temporary_archive" "$archive_path"
    unzip -oq "$archive_path" -d "$tool_dir"
    chmod +x "$godot_path"
  fi

  mkdir -p "$HOME/.local/bin"
  ln -sfn "$godot_path" "$HOME/.local/bin/godot"
  "$godot_path" --headless --version
}

step "Checking system prerequisites"
install_prerequisites
step "Installing the pinned Godot toolchain"
install_godot
step "Importing the project and registering global script classes"
"$godot_path" --headless --editor --path "$repo_root" --quit

echo "Orb setup complete."

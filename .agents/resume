#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
godot_path="$repo_root/.tools/godot/Godot_v4.7.2-stable_linux.x86_64"

if [[ ! -x "$godot_path" ]]; then
  echo "Godot is missing; run .agents/setup to restore the pinned toolchain." >&2
  exit 1
fi

mkdir -p "$HOME/.local/bin"
ln -sfn "$godot_path" "$HOME/.local/bin/godot"
echo "Orb resume check complete."
